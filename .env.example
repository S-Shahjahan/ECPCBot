NODE_ENV=production
PORT=3000
APP_URL=https://YOUR-APP.up.railway.app
# Supabase transaction/session pooler connection string. Percent-encode password characters.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER:5432/postgres
DATABASE_SSL=true
# Set to your database CA PEM when your provider requires a custom CA.
DATABASE_CA=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_SECRET=
# At least 16 characters; never commit the populated .env file.
ADMIN_PASSWORD=
WEBHOOK_VERIFY_TOKEN=
# Shared Meta app secret; may be overridden in each client profile.
META_APP_SECRET=
# Configure the supported Graph API version shown in your Meta app dashboard.
META_GRAPH_VERSION=v23.0
# Set to 1 only behind exactly one trusted reverse proxy (Railway/Render).
TRUST_PROXY=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
